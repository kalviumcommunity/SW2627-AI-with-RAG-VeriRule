APP_NAME=VeriRule API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./data/verirule.db
UPLOAD_DIRECTORY=./data/uploads
CHROMA_DIRECTORY=./data/chroma
CHROMA_COLLECTION=verirule_documents
RETRIEVAL_DISTANCE_THRESHOLD=0.35

# ── Optional LLM API keys for the Compliance Chat Assistant ──────────────────
# If neither key is set, the chat falls back to retrieval-only mode (no LLM needed).
# Set ONE of the following to enable AI-synthesized streaming answers:
GEMINI_API_KEY=
OPENAI_API_KEY=
